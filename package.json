{
  "name": "@mistralys/cli-menu",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript library for building interactive CLI menus with utilities for terminal output, script runners, changelog parsing, and help rendering.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./changelog": {
      "import": {
        "types": "./dist/changelog/index.d.ts",
        "default": "./dist/changelog/index.js"
      },
      "require": {
        "types": "./dist/changelog/index.d.cts",
        "default": "./dist/changelog/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release-check": "node scripts/cli.js release-check",
    "menu": "node scripts/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mistralys/cli-menu.git"
  },
  "homepage": "https://github.com/Mistralys/cli-menu#readme",
  "bugs": {
    "url": "https://github.com/Mistralys/cli-menu/issues"
  },
  "keywords": [
    "cli",
    "menu",
    "terminal",
    "interactive"
  ],
  "author": "Mistralys",
  "publishConfig": {
    "access": "public"
  }
}
